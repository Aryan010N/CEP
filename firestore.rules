rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isSameCommunity(communityId) {
      return isAuthenticated() && (
        getUserData().communityId == communityId || 
        getUserData().community_id == communityId
      );
    }

    function isWingRep(community_id, wing) {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/communities/$(community_id)) && 
         get(/databases/$(database)/documents/communities/$(community_id)).data.wing_reps[request.auth.uid] == wing) ||
        getUserData().role == 'wing_rep'
      );
    }

    // ==========================================
    // PRODUCTION COLLECTIONS
    // ==========================================

    // Users
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if request.auth.uid == uid;
      allow update: if request.auth.uid == uid || hasRole('admin');
    }

    // Tickets
    match /tickets/{ticketId} {
      allow read: if isAuthenticated() && (
        isSameCommunity(resource.data.communityId) || 
        isSameCommunity(resource.data.community_id) || 
        hasRole('admin')
      );
      allow create: if isAuthenticated()
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && (request.resource.data.submittedBy == request.auth.uid || request.resource.data.resident_id == request.auth.uid);
      allow update, delete: if isWingRep(resource.data.community_id, resource.data.wing) || hasRole('admin') || resource.data.resident_id == request.auth.uid;
    }

    // NGO Challenges
    match /challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.title.size() <= 140;
      allow update: if isAuthenticated();
      allow delete: if hasRole('admin') || resource.data.postedBy == request.auth.uid;
    }

    // Communities
    match /communities/{communityId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ==========================================
    // ISOLATED DEMO COLLECTIONS (demo_ prefix)
    // Completely isolated data store for /demo route
    // ==========================================

    match /demo_users/{uid} {
      allow read, write: if isAuthenticated();
    }

    match /demo_tickets/{ticketId} {
      allow read, write: if isAuthenticated();
    }

    match /demo_challenges/{challengeId} {
      allow read, write: if isAuthenticated();
    }

    match /demo_communities/{communityId} {
      allow read, write: if isAuthenticated();
    }
  }
}
