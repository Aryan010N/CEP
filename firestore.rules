rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isMemberOf(communityId) {
      return isAuthenticated() && (
        getUserData().community_id == communityId ||
        getUserData().communityId == communityId
      );
    }
    
    function isWingRep(communityId, wing) {
      return isMemberOf(communityId) && 
        getUserData().role == 'wing_rep' && 
        getUserData().wing == wing;
    }
    
    function isAdmin(communityId) {
      return isMemberOf(communityId) && getUserData().role == 'admin';
    }

    // Communities collection
    match /communities/{communityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isAdmin(communityId) || 
        // Allow users to join community (add themselves to members array)
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'server_updated_at'])
      );
      allow delete: if isAdmin(communityId);
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Tickets collection
    match /tickets/{ticketId} {
      allow read: if isAuthenticated();
      
      // Residents can create tickets for their own community
      allow create: if isAuthenticated() && 
        request.resource.data.community_id != null &&
        request.resource.data.title != null;
        
      // Updates based on role:
      // 1. Wing Reps can verify/reject tickets in their wing
      // 2. Admins can assign workers and update status
      // 3. Ticket creators can update description or resolve
      allow update: if isAuthenticated() && (
        isAdmin(resource.data.community_id) ||
        isWingRep(resource.data.community_id, resource.data.wing) ||
        resource.data.resident_id == request.auth.uid
      );
      
      allow delete: if isAuthenticated() && isAdmin(resource.data.community_id);
    }

    // Challenges collection (NGO Marketplace)
    match /challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      // Allow students to claim challenges or NGO to update details
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && getUserData().role == 'admin';
    }
  }
}
